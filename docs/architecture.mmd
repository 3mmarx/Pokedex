%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#FFFFFF",
    "primaryColor": "#F1F5F9",
    "primaryTextColor": "#0F172A",
    "primaryBorderColor": "#475569",
    "secondaryColor": "#E0F2FE",
    "secondaryTextColor": "#0F172A",
    "secondaryBorderColor": "#0284C7",
    "tertiaryColor": "#F8FAFC",
    "tertiaryTextColor": "#0F172A",
    "tertiaryBorderColor": "#64748B",
    "lineColor": "#475569",
    "textColor": "#0F172A",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#94A3B8",
    "edgeLabelBackground": "#FFFFFF",
    "fontFamily": "ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
  },
  "flowchart": { "curve": "basis", "padding": 16, "htmlLabels": false }
}}%%
flowchart LR
    user["User (terminal)"]

    subgraph app["pokedexcli"]
        direction TB
        repl["REPL"]
        cmds["Command handlers"]
        state[("Session state: caught Pokémon, map pages")]
        client["PokéAPI client"]
        cache[("TTL response cache")]

        repl -->|dispatch| cmds
        cmds <-->|read / update| state
        cmds -->|request data| client
        client <-->|get / store| cache
    end

    api["PokéAPI"]

    user -->|command| repl
    client -->|GET on cache miss| api
